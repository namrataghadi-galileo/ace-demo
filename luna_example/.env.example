# Copy to .env and replace each placeholder. Never commit a real API key.
GALILEO_API_KEY=<your-api-key>
GALILEO_CONSOLE_URL=https://console-<stack>.gcp-dev.galileo.ai
GALILEO_API_URL=https://api-<stack>.gcp-dev.galileo.ai
GALILEO_PROJECT=<project-name>
GALILEO_LOG_STREAM=<log-stream-name>
GALILEO_LOG_STREAM_ID=<log-stream-id>
AGENT_CONTROL_URL=<agent-control-url>
AGENT_CONTROL_AGENT_NAME=banking-multilevel-runtime-demo
AGENT_CONTROL_TARGET_TYPE=log_stream
AGENT_CONTROL_TARGET_ID=<same-log-stream-id>
AGENT_CONTROL_API_KEY_HEADER=Galileo-API-Key
