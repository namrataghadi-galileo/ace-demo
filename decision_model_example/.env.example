# Copy this file to decision_model_example/.env and replace every placeholder.
# Never commit a real API key.
GALILEO_API_KEY=<your-api-key>

# Set these to the Console and API endpoints for one environment (staging or a
# specific DevStack). Do not add a trailing /api to GALILEO_API_URL.
GALILEO_CONSOLE_URL=https://console-<environment-host>
GALILEO_API_URL=https://api-<environment-host>
# Usually the Agent Control Console proxy for that same environment.
AGENT_CONTROL_URL=https://console-<environment-host>/api/agent-control

# Existing project and log stream used for traces and the control binding.
GALILEO_PROJECT_ID=<project-id>
GALILEO_PROJECT=<project-name>
GALILEO_LOG_STREAM_ID=<log-stream-id>
GALILEO_LOG_STREAM=<log-stream-name>

# Agent Control uses the same Galileo API key through the Enterprise gateway.
AGENT_CONTROL_API_KEY_HEADER=Galileo-API-Key
AGENT_CONTROL_AGENT_NAME=decision-model-banking-streamlit
AGENT_CONTROL_TARGET_TYPE=log_stream
AGENT_CONTROL_TARGET_ID=<same-log-stream-id>
AGENT_CONTROL_RUNTIME_AUTH_MODE=jwt
