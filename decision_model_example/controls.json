[
  {
    "name": "test-jev-banking-transfer-safety-deny-tool",
    "description": "Deny an unsafe banking transfer before the transfer tool executes.",
    "manual_metadata": {
      "scorer_id": "<fill-from-galileo-ui:decision-model-scorer-id>",
      "scorer_version_id": "<fill-from-galileo-ui:decision-model-scorer-version-id>"
    },
    "definition": {
      "description": "Use a Jev decision model to block unsafe banking transfers before execution.",
      "enabled": true,
      "execution": "server",
      "scope": {
        "step_types": ["tool"],
        "stages": ["pre"],
        "step_name_regex": "^banking_jev_submit_transfer$"
      },
      "condition": {
        "selector": {"path": "input"},
        "evaluator": {
          "name": "galileo.decision_models",
          "config": {
            "scorer_label": "Banking transfer safety",
            "scorer_id": "<fill-from-galileo-ui:decision-model-scorer-id>",
            "scorer_version_id": "<fill-from-galileo-ui:decision-model-scorer-version-id>",
            "payload_field": "input",
            "operator": "gte",
            "threshold": 0.5,
            "timeout_ms": 10000
          }
        }
      },
      "action": {"decision": "deny"},
      "tags": ["banking", "decision-models", "jev", "tool"]
    }
  }
]
