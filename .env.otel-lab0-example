# Check-in-safe Lab0 direct OTLP configuration for run_demo_otel_splunk_ao.py.
#
# Keep credentials in the ignored .env file:
#   LAB0_INGEST_TOKEN=<your-lab0-ingest-token>
#   LAB0_SF_TOKEN=<your-lab0-sf-token>
#   LAB0_ORG_ID=<your-lab0-org-id>
#
# Run with:
#   SPLUNK_AO_ENV_FILE=.env.otel-lab0-example python run_demo_otel_splunk_ao.py

SPLUNK_AO_REALM=lab0
SPLUNK_AO_O11Y_API_ENDPOINT=https://api.lab0.observability.splunkcloud.com
SPLUNK_AO_O11Y_TOKEN=${LAB0_INGEST_TOKEN}
SPLUNK_AO_O11Y_API_TOKEN=${LAB0_INGEST_TOKEN}
SPLUNK_AO_PROJECT_ID=1083fca5-a910-4ef7-b151-64befe8ae2af
SPLUNK_AO_AGENT_STREAM_ID=3357d0a1-45d8-4a28-a760-01a16e1c71ba

AGENT_CONTROL_URL=https://app.lab0.signalfx.com/ao/agent-control
AGENT_CONTROL_API_KEY=${LAB0_SF_TOKEN}
AGENT_CONTROL_API_KEY_HEADER=X-SF-Token
AGENT_CONTROL_AGENT_NAME=agent-control-splunk-ao-otel-e2e
AGENT_CONTROL_TARGET_TYPE=agent_stream
AGENT_CONTROL_RUNTIME_AUTH_MODE=runtime_token
AGENT_CONTROL_RUNTIME_TOKEN_HEADER=X-Agent-Control-Runtime-Token
AGENT_CONTROL_SKIP_LUNA_CONTROL=true
AGENT_CONTROL_OBSERVABILITY_SINK_NAME=otel
AGENT_CONTROL_OTEL_ENABLED=true
